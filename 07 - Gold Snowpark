    col, avg, sum as sum_, count, round as round_,
    when, lit, lag, lead, rank, dense_rank, row_number,
    datediff, dateadd, trim, upper, lower, initcap,
    concat, coalesce, nullif, iff, least, greatest,
    min as min_, max as max_, stddev, variance
)
import pandas as pd
import numpy as np


