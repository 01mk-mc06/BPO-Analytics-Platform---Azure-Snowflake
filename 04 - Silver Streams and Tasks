-- quueue logs and JSON flattening
CREATE OR REPLACE TASK task_silver_queue_logs
  WAREHOUSE = bpo_transform_wh
  SCHEDULE = '2 MINUTE'
  WHEN SYSTEM$STREAM_HAS_DATA('bpo_db.bronze.stream_queue_logs')
AS
BEGIN

  -- Step A: Insert VALID records (flatten JSON)
  INSERT INTO bpo_db.silver.queue_events
  SELECT
    raw_data:log_id::VARCHAR,
    raw_data:agent_id::VARCHAR,
    raw_data:queue::VARCHAR,
    raw_data:event::VARCHAR,
    raw_data:timestamp::TIMESTAMP_NTZ,
    raw_data:metadata.priority::VARCHAR,
    raw_data:metadata.source::VARCHAR,
    raw_data:metadata.resolution::VARCHAR,
    raw_data:metadata.escalated_to::VARCHAR,
    'VALID',
    source_file,
    CURRENT_TIMESTAMP()
  FROM bpo_db.bronze.stream_queue_logs
  WHERE METADATA$ACTION = 'INSERT'
    AND raw_data:log_id::VARCHAR IS NOT NULL
    AND raw_data:agent_id::VARCHAR IS NOT NULL
    AND raw_data:agent_id::VARCHAR != '';

  -- Step B: Quarantine INVALID records
  INSERT INTO bpo_db.bronze.quarantine_records
    (source_table, raw_data, error_reason, retry_count, status, quarantined_at)
  SELECT
    'raw_queue_logs',
    log_data,
    CASE
      WHEN raw_data:log_id::VARCHAR IS NULL    THEN 'NULL log_id'
      WHEN raw_data:agent_id::VARCHAR IS NULL  THEN 'NULL agent_id'
      WHEN raw_data:agent_id::VARCHAR = ''     THEN 'Empty agent_id'
      ELSE 'Invalid record'
    END,
    0,
    'PENDING',
    CURRENT_TIMESTAMP()
  FROM bpo_db.bronze.stream_queue_logs
  WHERE METADATA$ACTION = 'INSERT'
    AND (
      raw_data:log_id::VARCHAR IS NULL
      OR raw_data:agent_id::VARCHAR IS NULL
      OR raw_data:agent_id::VARCHAR = ''
    );

END;

