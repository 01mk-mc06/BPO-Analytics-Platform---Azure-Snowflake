-- silver table transformations (cleaing and editing)
create or replace task task_silver_agents
    warehouse = bpo_transform_wh
    schedule = '2 minute'
    when system$stream_has_data('bpo_db.bronze.stream_agents')
as
begin
-- inserting records into the silver table
    insert into bpo_db.silver.agents
    select
        upper(trim(agent_id)),
        initcap(trim(name)),
        upper(trim(team)),
        initcap(trim(site)),
        tenure_years,
        hire_date,
        lower(trim(email)),
        upper(trim(status)),
        'valid',
        source_file,
        current_timestamp()
    from bpo_db.bronze.stream_agents
    where metadata$action = 'INSERT'
        and agent_id is not null 
        and name is not null
        and status in ('Active','Inactive','active','inactive');
        
-- inserting quarantine record into the quarantine table; invalid records
    insert into bpo_db.bronze.quarantine_records
        (source_table, raw_data, error_reason, retry_count, status, quarantined_at)
    select 
        'raw_agents',
        to_variant(object_construct(
        'agent_id', agent_id,
        'name', name,
        'team', team,
        'status', status
        )),
        case
            when agent_id is null then 'NULL agent_id'
            when name is null then 'NULL name'
            else 'invalid status value'
        end,
        0,
        'pending',
        current_timestamp()
    from bpo_db.bronze.stream_agents
    where metadata$action = 'INSERT'
        and (
            agent_is is null
            or name is null
            or status not in ('Active','Inactive','active','inactive')
        );
end;

-- tickets
create or replace task task_silver_tickets 
    warehouse = bpo_transform_wh
    schedule = '1 minute'
    when system$stream_has_data('bpo_db.bronze.stream_tickets')
as
begin
    -- inserting valid rows to silver
    insert into bpo_db.silver.tickets
    select
        upper(trim(ticket_id)),
        upper(trim(agent_id)),
        initcap(trim(ticket_type)),
        initcap(trim(priority)),
        initcap(trim(status)),
        resolution_time_mins, 
        created_date, 
        initcap(trim(category)),
        case
            when priority = 'Critical' and resolution_time_mins > 30 then TRUE
            when priority = 'High' and resolution_time_mins > 60 then TRUE
            else false
        end,
        'valid',
        source_file,
        current_timestamp(),
    from bpo_db.bronze.stream_tickets
    where metadata$action = 'INSERT'
        and ticket_id is not null
        and agent_id is not null
        and resolution_time_mins is not null;

    --- quarantined rows
    insert into bpo_db.bronze.quarantine_records
        (source_table, raw_data, error_reason, retry_count, status, quarantined_at)
       select
        'raw_tickets',
        to_variant(object_construct(
            'ticket_id', ticket_id,
            'agent_id', agent_id,
            'resolution_time_mins', resolution_time_mins,
            'status', status
        )), 
        case
            when ticket_id is null then 'NULL ticket_id'
            when agent_id is null then 'NULL agent_id'
            when resolution_time < 0 then 'Negative resolution time'
            else 'Invalid record'
        end, 
        0,
        'pending',
        current_timestamp()
        from bpo_db.bronze.stream_tickets
        where metadata$action = 'INSERT'
            and (
            ticket_id is NULL
            or agent_id is NULL
            or resolution_time_mins null
            );
end;

