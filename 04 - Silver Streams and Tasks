-- stream performance
CREATE OR REPLACE TASK task_silver_performance
  WAREHOUSE = bpo_transform_wh
  SCHEDULE = '2 MINUTE'
  WHEN SYSTEM$STREAM_HAS_DATA('bpo_db.bronze.stream_performance')
AS
BEGIN

  -- Step A: Insert VALID records
  INSERT INTO bpo_db.silver.performance
  SELECT
    UPPER(TRIM(perf_id)),
    UPPER(TRIM(agent_id)),
    date,
    aht_mins,
    accuracy_pct,
    tickets_handled,
    quality_score,
    CASE
      WHEN quality_score >= 90 THEN 'Top'
      WHEN quality_score >= 80 THEN 'Mid'
      ELSE 'Low'
    END,
    'VALID',
    source_file,
    CURRENT_TIMESTAMP()
  FROM bpo_db.bronze.stream_performance
  WHERE METADATA$ACTION = 'INSERT'
    AND agent_id IS NOT NULL
    AND aht_mins IS NOT NULL
    AND aht_mins BETWEEN 1 AND 120
    AND accuracy_pct BETWEEN 0 AND 100;

  -- Step B: Quarantine INVALID records
  INSERT INTO bpo_db.bronze.quarantine_records
    (source_table, raw_data, error_reason, retry_count, status, quarantined_at)
  SELECT
    'raw_performance',
    TO_VARIANT(OBJECT_CONSTRUCT(
      'perf_id', perf_id,
      'agent_id', agent_id,
      'aht_mins', aht_mins,
      'accuracy_pct', accuracy_pct
    )),
    CASE
      WHEN agent_id IS NULL                    THEN 'NULL agent_id'
      WHEN aht_mins IS NULL                    THEN 'NULL aht_mins'
      WHEN aht_mins NOT BETWEEN 1 AND 120      THEN 'AHT out of range'
      WHEN accuracy_pct NOT BETWEEN 0 AND 100  THEN 'Accuracy out of range'
      ELSE 'Invalid record'
    END,
    0,
    'PENDING',
    CURRENT_TIMESTAMP()
  FROM bpo_db.bronze.stream_performance
  WHERE METADATA$ACTION = 'INSERT'
    AND (
      agent_id IS NULL
      OR aht_mins IS NULL
      OR aht_mins NOT BETWEEN 1 AND 120
      OR accuracy_pct NOT BETWEEN 0 AND 100
    );

END;

