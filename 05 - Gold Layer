-- queue health
create or replace dynamic table bpo_db.gold.queue_health
    target_lag = '2 minutes'
    warehouse = bpo_transform_wh
as
select
    queue,
    date(event_time)                                    as event_date,
    count(*)                                            as total_events,
    count(case when event = 'ticket_opened' then 1 end) as tickets_opened,
    count(case when event = 'ticket_closed' then 1 end) as tickets_closed,
    count(case when event = 'escalated'     then 1 end) as escalations,
    -- backlog = opened - closed
    count(case when event = 'ticket_opened' then 1 end) -
    count(case when event = 'ticket_closed' then 1 end) as backlog,
    -- escalation rate
    round(
        count(case when event = 'escalated' then 1 end) /
        nullif(count(case when event = 'ticket_opened' then 1 end), 0) * 100
    , 2)                                                as escalation_rate_pct,
    count(distinct agent_id)                            as agents_handling,
    current_timestamp()                                 as refreshed_at
from bpo_db.silver.queue_events
where record_status = 'VALID'
group by queue, date(event_time);

-- check queue health table
select * from bpo_db.gold.queue_health;


-- team performance
-- checking the needed tables
select * from bpo_db.silver.performance;
select * from bpo_db.silver.agents;

create or replace dynamic table bpo_db.gold.team_performance
    target_lag = '2 minutes'
    warehouse = bpo_transform_wh
as
select
    a.team,
    a.site,
    count(distinct p.agent_id)                          as total_agents,
    sum(p.tickets_handled)                              as total_tickets,
    avg(p.aht_mins)                                     as avg_aht,
    avg(p.accuracy_pct)                                 as avg_accuracy,
    avg(p.quality_score)                                as avg_quality,
    min(p.quality_score)                                as min_quality,
    max(p.quality_score)                                as max_quality,
    -- team performance tier
    case
        when avg(p.quality_score) >= 90 then 'High Performing'
        when avg(p.quality_score) >= 80 then 'On Track'
        else 'Needs Attention'
    end                                                 as team_tier,
    current_timestamp()                                 as refreshed_at
from bpo_db.silver.performance p
join bpo_db.silver.agents a
    on p.agent_id = a.agent_id
where p.record_status = 'VALID'
    and a.record_status = 'VALID'
group by a.team, a.site;

select * from bpo_db.gold.team_performance;


-- ticket summary
-- checking the needed tables
select * from bpo_db.silver.tickets;

create or replace dynamic table bpo_db.gold.ticket_summary
    target_lag = '2 minutes'
    warehouse = bpo_transform_wh
as
select
    created_date,
    ticket_type,
    priority,
    category,
    count(*)                                                        as total_tickets,
    count(case when status = 'Closed' then 1 end)                   as closed_tickets,
    count(case when status = 'Open'   then 1 end)                   as open_tickets,
    -- resolution rate
    round(
        count(case when status = 'Closed' then 1 end) /
        nullif(count(*), 0) * 100
    , 2)                                                            as resolution_rate_pct,
    -- sla metrics
    count(case when is_sla_breached = true then 1 end)              as sla_breaches,
    round(
        count(case when is_sla_breached = true then 1 end) /
        nullif(count(*), 0) * 100
    , 2)                                                            as sla_breach_rate_pct,
    avg(resolution_time_mins)                                       as avg_resolution_time,
    max(resolution_time_mins)                                       as max_resolution_time,
    current_timestamp()                                             as refreshed_at
from bpo_db.silver.tickets
where record_status = 'VALID'
group by created_date, ticket_type, priority, category;

select * from bpo_db.gold.ticket_summary;
