create or replace dynamic table bpo_db.gold.agent_scorecard
    target_lag = '2 minutes'
    warehouse = bpo_transform_wh
as
select 
    p.agent_id,
    a.name,
    a.team,
    a.site,
    a.tenure_years,
    a.status,
    -- KPI volume metrics
    sum(p.tickets_handled)          as total_tickets,
    avg(p.tickets_handled)          as avg_daily_tickets,
    -- quality scoring
    -- efficiency metrics
    avg(p.aht_mins)                as avg_aht,
    -- effectiveness metrics
    avg(p.accuracy_pct)             as avg_accuracy,
    avg(p.quality_score)            as avg_quality_score,
    -- performance tier
    case
        when avg(p.quality_score) >= 90 then 'Top Performer'
        when avg(p.quality_score) >= 80 then 'Mid Performer'
        else 'Needs improvement'
    end                             as performance_tier,
    round(
    (avg(p.quality_score)*0.4) +
    (avg(p.quality_score)*0.4) +
    (least(avg(p.tickets_handled) / 50 * 100, 100) * 0.2)
    ,2)                             as composite_score,
    max(p.date)                  as last_active_date,
    current_timestamp()             as refreshed_at
    -- source and joining
    from bpo_db.silver.performance p
    join bpo_db.silver.agents a 
    on p.agent_id = a.agent_id
    where p.record_status = 'VALID' -- fix this upper and lower case
        and a.record_status = 'valid'
    group by -- 1,2,3,4,5,6
    p.agent_id, a.name, a.team, a.site, a.tenure_years, a.status;

-- for checking
select * from bpo_db.gold.agent_scorecard

-- team performance gold table
create or replace dynamic table bpo_db.gold.daily_ops_report
    target_lag = '2 minutes'
    warehouse = bpo_transform_wh
as 
select
    p.date,
    a.site,
    a.team,
    -- KPI efficiency volume
    count(distinct(p.agent_id))     as agents_active,
    sum(p.tickets_handled)          as total_tickets_handled,
    -- quality KPI
    avg(aht_mins)                as avg_aht,
    avg(accuracy_pct)               as avg_accuracy,
    avg(p.quality_score)            as avg_quality,
    -- SLA from tickets
    count(case
        when t.is_sla_breached = True then 1
        end
        )                           as sla_breached,
    -- trend vs previous day; LAG function
    avg(p.quality_score) - lag(avg(p.quality_score)) over (
        partition by a.site, a.team
        order by p.date
    )                               as quality_trend,
    current_timestamp()             as refreshed_at
    -- source table and joining
    from bpo_db.silver.performance p
    join bpo_db.silver.agents a on p.agent_id = a.agent_id
    left join bpo_db.silver.tickets t on t.agent_id = p.agent_id
        and t.created_date = p.date
    where p.record_status = 'VALID' 
        and a.record_status = 'valid'
    group by 1,2,3

select * from bpo_db.gold.daily_ops_report
    

