use database bpo_db;
use schema bpo_db.bronze;
use warehouse bpo_ingestion_wh;

-- check the azure stage
list @bpo_azure_stage;

--
create or replace pipe bpo_db.bronze.pipe_agents
    auto_ingest = true
    integration = bpo_azure_notification_int
as
copy into bpo_db.bronze.raw_agents (agent_id, name, team, site, tenure_years, hire_date, email, status, source_file)
from (
    select $1, $2, $3, $4, $5, $6, $7, $8,
        metadata$filename
    from @bpo_azure_stage/agents.csv
)
file_format = csv_format;

select * from bpo_db.bronze.raw_agents;

-- drop pipe bronze.pipe_tickets;
-- ticket pipe
create or replace pipe bpo_db.bronze.pipe_tickets
    auto_ingest = true
    integration = bpo_azure_notification_int
as
copy into bpo_db.bronze.raw_tickets (ticket_id, agent_id, ticket_type, priority, status, resolution_time_mins, created_date, category, source_file)
from (
    select $1, $2, $3, $4, $5, $6, $7, $8,
        metadata$filename
    from @bpo_azure_stage/tickets.csv
)
file_format = csv_format;

select * from bpo_db.bronze.raw_tickets;

-- agent_performance pipe
create or replace pipe bpo_db.bronze.pipe_performance
    auto_ingest = true
    integration = bpo_azure_notification_int
as
copy into bpo_db.bronze.raw_performance (perf_id, agent_id, date, aht_mins, accuracy_pct, tickets_handled, quality_score, source_file)
from (
    select $1, $2, $3, $4, $5, $6, $7,
        metadata$filename
    from @bpo_azure_stage/agent_performance.csv
)
file_format = csv_format;

select * from bpo_db.bronze.raw_performance;

-- queue logs pipe
create or replace pipe bpo_db.bronze.pipe_queue_logs
    auto_ingest = true
    integration = bpo_azure_notification_int
as
copy into bpo_db.bronze.raw_queue_logs (raw_data, source_file)
from (
    select $1,
        metadata$filename
    from @bpo_azure_stage/queue_logs.json
)
file_format = json_format;

select * from bpo_db.bronze.raw_queue_logs;

-- pipe verification
-- check all pipes are running
show pipes in schema bpo_db.bronze;
select system$pipe_status('bpo_db.bronze.pipe_agents');
select system$pipe_status('bpo_db.bronze.pipe_tickets');
select system$pipe_status('bpo_db.bronze.pipe_performance');
select system$pipe_status('bpo_db.bronze.pipe_queue_logs');

